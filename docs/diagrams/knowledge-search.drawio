<mxfile host="drawio"><diagram name="knowledge-search" id="knowledge-search"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="search_knowledge: spine-first retrieval, corrected when the context is thin" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="900" height="26" as="geometry"/></mxCell><mxCell id="c2" value="Used by the assistant&amp;#x27;s search_knowledge tool; every number in the answer is then checked" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="52" width="900" height="20" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Question&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="340" height="46" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;L1: refresh the context spine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;content-hash upsert, one DB read if unchanged&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="176" width="340" height="54" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;L2: hybrid retrieval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;BM25 + vector (Oracle 23ai VECTOR_DISTANCE)&lt;br&gt;+ billing-cycle ranker&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="262" width="340" height="70" as="geometry"/></mxCell><mxCell id="rrf" value="&lt;b&gt;Reciprocal Rank Fusion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;k = 60&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="362" width="340" height="46" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;Grader (cheap LLM):&lt;br&gt;enough relevant&lt;br&gt;documents?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="438" width="260" height="96" as="geometry"/></mxCell><mxCell id="crag" value="&lt;b&gt;Corrective RAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;widen to top 14 · fetch every doc of&lt;br&gt;the cycle · CDR-evidence tool&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="448" width="260" height="76" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;rules + shared knowledge [G#], customer docs [D#]&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="566" width="340" height="54" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;LLM writes the answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;every factual sentence cites [D#]/[G#]&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="340" height="46" as="geometry"/></mxCell><mxCell id="v" value="&lt;b&gt;Every number in&lt;br&gt;the docs it cites?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=4;" vertex="1" parent="1"><mxGeometry x="290" y="726" width="280" height="96" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Answer + citations + trace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;VERIFIED or REPAIRED&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="852" width="340" height="46" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;Repair with the problems fed back&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;up to 2x, tools allowed&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="742" width="260" height="64" as="geometry"/></mxCell><mxCell id="no" value="&lt;b&gt;Says it can&amp;#x27;t verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;never a template&lt;/font&gt;" style="rounded=1;arcSize=14;whi