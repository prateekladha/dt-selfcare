<mxfile host="drawio"><diagram name="j3-usage-alert" id="j3-usage-alert"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Usage record to 80% alert: exactly once, end to end" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="900" height="26" as="geometry"/></mxCell><mxCell id="c2" value="Every step is idempotent, so a retry anywhere can&amp;#x27;t double-count or double-notify" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="52" width="900" height="20" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Network mediation (emulator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;POST /v1/usage-batches {batch_id, records[]}&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="24" y="112" width="360" height="54" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;usage-collector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;batch done? → 200 duplicate (Valkey SET NX)&lt;br&gt;screen records, dedupe record_id, quarantine invalid&lt;br&gt;partition = crc32(sub) % 4, gzip, msg_id = sha256(…)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="206" width="360" height="88" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;OCI Streaming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;usage-events, 4 partitions&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=6;" vertex="1" parent="1"><mxGeometry x="74" y="334" width="260" height="66" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;usage-aggregator ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;one Lua call per message, all keys tagged {p}&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="444" width="360" height="54" as="geometry"/></mxCell><mxCell id="r" value="&lt;b&gt;alert-relay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;Valkey stream alerts:{p} → topic usage-alerts, then XACK&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="540" width="360" height="54" as="geometry"/></mxCell><mxCell id="t" value="&lt;b&gt;notifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;INSERT notification, UNIQUE alert_id (duplicate dropped)&lt;br&gt;then Valkey PUBLISH notif:sub&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="636" width="360" height="70" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;core-api SSE → browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;toast + page data refreshed&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="748" width="360" height="54" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n" target="c"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="202 accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="n"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="produce, acks=all" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="s"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="group usage-aggregator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="alert outbox (Valkey stream)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a" target="r"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="topic usage-alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r" target="t"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="PUBLISH → SUBSCRIBE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t" target="b"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="v" value="&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;counters, idempotency keys&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="216" width="230" height="68" as="geometry"/></mxCell><mxCell id="c18" value="batch:id, rec:id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c" target="v"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="os" value="&lt;b&gt;Object Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4b5563&quot;&gt;raw CDR archive&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="334" width="190" height="66" as="geometry"/></mxCell><mxCell id="c20" value="group raw-archiver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="os"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="lua" value="&lt;b&gt;Inside the Lua script (atomic)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4b5563&quot;&gt;1. offset ≤ off:{p}? → stale, no-op&lt;br&gt;2. seen:{p}:msg exists? → duplicate, no-op&lt;br&gt;3. HINCRBY totals and day fields; pct = used / allowance&lt;br&gt;4. pct ≥ 80 and HSETNX alert:80 → XADD alerts:{p}&lt;br&gt;    (alert_id = sub:cycle:level:offset, one per arming)&lt;br&gt;5. SET seen, SET off:{p} = offset&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=left;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="460" height="176" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#b08b2a;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="a" target="lua"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>