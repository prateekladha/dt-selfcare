<mxfile host="drawio"><diagram name="payment-states" id="payment-states"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Payment states: PAID is reached once, on the gateway&amp;#x27;s word" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="820" height="26" as="geometry"/></mxCell><mxCell id="st" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="24" y="126" width="32" height="32" as="geometry"/></mxCell><mxCell id="cr" value="&lt;b&gt;CREATED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4b5563&quot;&gt;order created&lt;br&gt;(idempotency key)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="110" width="170" height="64" as="geometry"/></mxCell><mxCell id="pe" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4b5563&quot;&gt;attempted or authorised,&lt;br&gt;not captured yet&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="170" height="64" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;EXPIRED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4b5563&quot;&gt;final&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="170" height="64" as="geometry"/></mxCell><mxCell id="pa" value="&lt;b&gt;PAID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4b5563&quot;&gt;final, exactly once&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="355" y="350" width="170" height="64" as="geometry"/></mxCell><mxCell id="fa" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4b5563&quot;&gt;still checked by&lt;br&gt;the reconciler&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="170" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="st" target="cr"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="attempt seen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="cr" target="pe"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="captured" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="cr" target="pa"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="captured" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="pe" target="pa"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="gateway: failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="pe" target="fa"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="retried on the same&lt;br&gt;order and captured" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="fa" target="pa"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="after 24 h with no attempt,&lt;br&gt;or only attempted&lt;br&gt;(also from PENDING)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="cr" target="ex"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>