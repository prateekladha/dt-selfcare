id="c26" value="10. PAID + bill settled + outbox event&lt;br&gt;(one transaction, exactly once)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="500.0" y="576" width="278.0" height="40" as="geometry"/></mxCell><mxCell id="c27" value="11. webhook (HMAC): same path, no-op if already PAID" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470.0" y="636" width="376.0" height="23" as="geometry"/></mxCell><mxCell id="c28" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642.0" y="663" as="sourcePoint"/><mxPoint x="462.0" y="663" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="12. PAYMENT_SUCCEEDED event → notification&lt;br&gt;(billing already settled)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470.0" y="681" width="344.0" height="40" as="geometry"/></mxCell><mxCell id="c30" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.0" y="725" as="sourcePoint"/><mxPoint x="822.0" y="725" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>