="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="110.0" y="156" width="320.0" height="23" as="geometry"/></mxCell><mxCell id="c8" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="102.0" y="183" as="sourcePoint"/><mxPoint x="282.0" y="183" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="2. POST /v1/me/payments  + Idempotency-Key" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290.0" y="201" width="306.0" height="23" as="geometry"/></mxCell><mxCell id="c10" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="282.0" y="228" as="sourcePoint"/><mxPoint x="462.0" y="228" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.0" y="246" as="sourcePoint"/><mxPoint x="462.0" y="286" as="targetPoint"/><Array as="points"><mxPoint x="490.0" y="246"/><mxPoint x="490.0" y="286"/></Array></mxGeometry></mxCell><mxCell id="c12" value="3. same key or open order? → return it&lt;br&gt;amount from the bill, server side (EUR/PLN × fx → INR)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="500.0" y="246" width="390.0" height="40" as="geometry"/></mxCell><mxCell id="c13" value="4. create order" style="text;html=1;whiteSpace=w