<mxfile host="drawio"><diagram name="j5-explanation" id="j5-explanation"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Bill explanation: the AI only rewords checked facts, or says nothing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="860" height="26" as="geometry"/></mxCell><mxCell id="c2" value="The breakdown and numbers always come from the deterministic explainer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="52" width="860" height="20" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;Deterministic facts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;explainer.explain: always shown&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="300" height="54" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;Numbered sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;S1..Sn + tariff knowledge G1..Gn&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="186" width="300" height="54" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Cache hit?&lt;br&gt;sources, language, model,&lt;br&gt;prompt text served&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="240" height="96" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Daily AI limit and&lt;br&gt;spend cap OK?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="396" width="240" height="90" as="geometry"/></mxCell><mxCell id="l" value="&lt;b&gt;One JSON LLM call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;via the LLM gateway, prompt from Langfuse&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="300" height="54" as="geometry"/></mxCell><mxCell id="v" value="&lt;b&gt;Every item cites sources&lt;br&gt;and every number&lt;br&gt;is in them?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=14;fontFamily=Helvetica;strokeWidth=1.25;spacing=4;" vertex="1" parent="1"><mxGeometry x="310" y="606" width="280" height="104" as="geometry"/></mxCell><mxCell id="sv" value="&lt;b&gt;Cache 30 days&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="744" width="300" height="46" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Explanation shown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;cached or fresh&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;spacin