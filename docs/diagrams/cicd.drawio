l><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mg" target="t"><mxGeometry relative="1"  as="geometry"><Array as="points"><mxPoint x="240.0" y="430"/><mxPoint x="480" y="430"/><mxPoint x="480" y="137"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Any red step stops the pipeline. The eval gate fails on:&lt;br&gt;• grounded answers &amp;lt; 90%&lt;br&gt;• required facts mentioned &amp;lt; 80%&lt;br&gt;• tools used &amp;lt; 85%&lt;br&gt;• policy judge pass &amp;lt; 80% (only when κ ≥ 0.6)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#374151;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="440" width="440" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>