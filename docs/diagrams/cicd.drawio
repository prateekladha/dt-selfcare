<mxfile host="drawio"><diagram name="cicd" id="cicd"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="Merge to main: deploy.yml" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff7fb;strokeColor=#f9a8d4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13.5;fontColor=#be185d;fontFamily=Helvetica;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="500" y="76" width="432" height="520" as="geometry"/></mxCell><mxCell id="c2" value="Pull request: pr.yml" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#93c5fd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13.5;fontColor=#1d4ed8;fontFamily=Helvetica;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="24" y="76" width="432" height="260" as="geometry"/></mxCell><mxCell id="c1" value="Only a green build reaches production, and the assistant must pass its eval gate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="860" height="26" as="geometry"/></mxCell><mxCell id="py" value="&lt;b&gt;Python&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;ruff + pytest&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="400" height="46" as="geometry"/></mxCell><mxCell id="wb" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;typecheck + build&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="400" height="46" as="geometry"/></mxCell><mxCell id="dc" value="&lt;b&gt;Deploy config&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;helm lint + kubeconform, terraform fmt + validate&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="46" as="geometry"/></mxCell><mxCell id="im" value="&lt;b&gt;Image builds&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="196.0" height="46" as="geometry"/></mxCell><mxCell id="gl" value="&lt;b&gt;gitleaks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;secrets scan&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="244.0" y="274" width="196.0" height="46" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b&gt;Merge to protected main&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="400" height="46" as="geometry"/></mxCell><mxCell id="t" value="&lt;b&gt;Tests again&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;same suite as the PR&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="112" width="400" height="50" as="geometry"/></mxCell><mxCell id="i" value="&lt;b&gt;Build + push images to OCIR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;tag = git sha&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="180" width="400" height="50" as="geometry"/></mxCell><mxCell id="h" value="&lt;b&gt;helm upgrade --wait&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;OCI CI user with deploy-only permissions&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="248" width="400" height="50" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;In-cluster smoke test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;helm test: 19 checks, every case-study flow&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="316" width="400" height="50" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Playwright e2e on the live site&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;desktop, tablet, mobile&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="384" width="400" height="50" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Payment e2e&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;real Razorpay test checkout&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=1.25;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="452" width="400" height="50" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;Assistant eval gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#4b5563&quot;&gt;judge calibration (κ ≥ 0.6) + 17 golden questions&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#1f2937;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="516" y="520" width="400" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t" target="i"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i" target="h"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#6b7280;strokeWidth=1.5;fontSize=12;fontColor=#4b5563;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h"