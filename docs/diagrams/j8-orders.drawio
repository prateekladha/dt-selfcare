7;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="110.0" y="156" width="306.0" height="23" as="geometry"/></mxCell><mxCell id="c8" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="102.0" y="183" as="sourcePoint"/><mxPoint x="282.0" y="183" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="282.0" y="201" as="sourcePoint"/><mxPoint x="282.0" y="241" as="targetPoint"/><Array as="points"><mxPoint x="310.0" y="201"/><mxPoint x="310.0" y="241"/></Array></mxGeometry></mxCell><mxCell id="c10" value="2. one open offer per kind: an older one is&lt;br&gt;expired as &amp;quot;Replaced by a newer offer&amp;quot;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="320.0" y="201" width="313.0" height="40" as="geometry"/></mxCell><mxCell id="c11" value="3. approval card: price + VAT, effect this month" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="110.0" y="261" width="348.0" height="23" as="geometry"/></mxCell><mxCell id="c12" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="282.0" y="288" as="sourcePoint"/><mxPoint x="102.0" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="4. approve" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="110.0" y="306" width="164.0" height="23" as="geometry"/></mxCell><mxCell id="c14" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="102.0" y="333" as="sourcePoint"/><mxPoint x="282.0" y="333" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="5. start workflow, id = order id&lt;br&gt;(a double click can&amp;#x27;t start two)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290.0" y="351" width="236.0" height="40" as="geometry"/></mxCell><mxCell id="c16" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="282.0" y="395" as="sourcePoint"/><mxPoint x="462.0" y="395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="6. TMF622 ProductOrder  (per-country rate cap)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470.0" y="413" width="334.0" height="23" as="geometry"/></mxCell><mxCell id="c18" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.0" y="440" as="sourcePoint"/><mxPoint x="642.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="7. submit  (takes 2 to 5 s)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="650.0" y="458" width="201.0" height="23" as="geometry"/></mxCell><mxCell id="c20" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642.0" y="485" as="sourcePoint"/><mxPoint x="822.0" y="485" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="8. result via bss-events,&lt;br&gt;or a status poll if the event is lost" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470.0" y="503" width="344.0" height="40" as="geometry"/></mxCell><mxCell id="c22" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="822.0" y="547" as="sourcePoint"/><mxPoint x="462.0" y="547" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.0" y="565" as="sourcePoint"/><mxPoint x="462.0" y="605" as="targetPoint"/><Array as="points"><mxPoint x="490.0" y="565"/><mxPoint x="490.0" y="605"/></Array></mxGeometry></mxCell><mxCell id="c24" value="9. add-on record into the usage pipeline;&lt;br&gt;wait until it&amp;#x27;s applied" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="500.0" y="565" width="299.0" height="40" as="geometry"/></mxCell><mxCell id="c25" value="10. COMPLETED: order-events, notification, home refresh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;fontFamily=Helvetica;spacing=0;fillColor=#ffffff;